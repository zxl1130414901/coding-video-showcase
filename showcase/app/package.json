{
  "name": "code-to-video-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "65 个代码转视频开源项目横向对比与样例播放前端",
  "scripts": {
    "predev": "node scripts/prepare-thumbs.mjs --allow-sample",
    "dev": "vite",
    "prebuild": "node scripts/prepare-thumbs.mjs",
    "build": "vite build",
    "prebuild:sample": "node scripts/prepare-thumbs.mjs --allow-sample",
    "build:sample": "node scripts/vite-build-sample.mjs",
    "preview": "vite preview",
    "lint": "eslint src vite.config.ts scripts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,md}\" \"scripts/**/*.mjs\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,md}\" \"scripts/**/*.mjs\" \"docs/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "link:samples": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/link-samples.ps1",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "playwright-core": "1.57.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vite": "6.0.7",
    "vite-plugin-singlefile": "2.1.0",
    "vitest": "3.2.4"
  }
}
